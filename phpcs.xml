<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PHP_CodeSniffer"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
    <file>src</file>
    <file>tests</file>

	<arg name="colors"/>

    <rule ref="PSR1">
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
    </rule>

    <rule ref="PSR12"/>

    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>src/Core/TransformLocaleExtensions.php</exclude-pattern>
        <exclude-pattern>tests/GitHub/UrlResolverTest.php</exclude-pattern>
        <exclude-pattern>tests/Core/LanguageIdTest.php</exclude-pattern>
        <exclude-pattern>tests/Core/LocaleIdTest.php</exclude-pattern>
        <exclude-pattern>tests/Core/UnicodeLocaleExtensionsTest.php</exclude-pattern>
    </rule>
</ruleset>
